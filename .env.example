# ================================================================
# UDAAN CLUB - ENVIRONMENT CONFIGURATION TEMPLATE
# ================================================================
# Copy this file to .env and fill in your actual credentials:
# cp .env.example .env
# ================================================================

# Supabase Configuration
# Obtain from: https://supabase.com/dashboard/project/<PROJECT_ID>/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Google Apps Script Email Service (Automated credential dispatch)
VITE_EMAIL_API_URL=https://script.google.com/macros/s/your-deployment-id/exec
VITE_EMAIL_API_TOKEN=your-secure-token-here
VITE_EMAIL_API_URL_BACKUP=https://script.google.com/macros/s/your-backup-id/exec
